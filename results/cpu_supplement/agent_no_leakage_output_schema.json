{
  "type": "object",
  "required": [
    "patient_id",
    "final_pred",
    "confidence",
    "trusted_models",
    "conflicts",
    "ihc_suggest",
    "screening_positioning",
    "safety_flags",
    "report"
  ],
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "final_pred": {
      "enum": [
        "sensitive",
        "nonsensitive"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "trusted_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ihc_suggest": {
      "enum": [
        "MMR",
        "EBER-ISH",
        "both",
        "none"
      ]
    },
    "screening_positioning": {
      "type": "string",
      "description": "Must state molecular-test pre-screening only; not diagnosis or treatment decision."
    },
    "safety_flags": {
      "type": "array",
      "items": {
        "enum": [
          "no_label_leakage",
          "m1_fixed",
          "no_unverified_morphology"
        ]
      },
      "description": "Required guardrails: no true labels loaded, final_pred fixed to M1, no morphology claims without rendered pathology evidence."
    },
    "report": {
      "type": "string",
      "description": "Chinese text. No morphology claims unless real rendered patch evidence and pathologist validation are supplied."
    },
    "backend": {
      "type": "string"
    },
    "deepseek_model": {
      "type": "string"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
